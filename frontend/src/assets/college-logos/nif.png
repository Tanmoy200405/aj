	    <link href="https://www.nifglobalkolkata.com/wp-content/themes/inifd/js/owl-carousel/owl.carousel.css" rel="stylesheet">
    <link href="https://www.nifglobalkolkata.com/wp-content/themes/inifd/css/site.css" rel="stylesheet">
    <link href="https://www.nifglobalkolkata.com/wp-content/themes/inifd/css/responsive.css" rel="stylesheet">
    
	<script type="text/javascript" src="https://www.nifglobalkolkata.com/wp-content/themes/inifd/js/jquery.min.js"></script>
	<script type="text/javascript" src="https://www.nifglobalkolkata.com/wp-content/themes/inifd/js/bootstrap.js"></script>
    <script type="text/javascript" src="https://www.nifglobalkolkata.com/wp-content/themes/inifd/js/owl-carousel/owl.carousel.js"></script>
	
    
    <script type="text/javascript">
        $(document).ready(function() {
            //Listing Slider
            $("#testimonial-scroll").owlCarousel({
                items : 3,
                navigation : false,
                //navigationText : ["<i class='fa fa-long-arrow-left' aria-hidden='true'></i>", "<i class='fa fa-long-arrow-right' aria-hidden='true'></i>"],
            });
			$("#brands-scroll").owlCarousel({
                items : 4,
				pagination : false,
                navigation : true,
                navigationText : ["<i class='fa fa-long-arrow-left' aria-hidden='true'></i>", "<i class='fa fa-long-arrow-right' aria-hidden='true'></i>"],
            });
			
			$("#service-scroll").owlCarousel({
                items : 3,
				pagination : false,
                navigation : true,
                navigationText : ["<i class='fa fa-angle-left' aria-hidden='true'></i>", "<i class='fa fa-angle-right' aria-hidden='true'></i>"],
            });
			
			$("#video-scroll").owlCarousel({
                items : 3,
				pagination : false,
                navigation : true,
                navigationText : ["<i class='fa fa-angle-left' aria-hidden='true'></i>", "<i class='fa fa-angle-right' aria-hidden='true'></i>"],
            });
			$("#mentor-scroll").owlCarousel({
                items : 3,
				pagination : false,
                navigation : true,
                navigationText : ["<i class='fa fa-angle-left' aria-hidden='true'></i>", "<i class='fa fa-angle-right' aria-hidden='true'></i>"],
            });
			$("#event-scroll").owlCarousel({
                items : 2,
				pagination : false,
                navigation : true,
                navigationText : ["<i class='fa fa-angle-left' aria-hidden='true'></i>", "<i class='fa fa-angle-right' aria-hidden='true'></i>"],
            });
			
			//Popup Show
			setTimeout(function(){
			if ($('body').hasClass('home')) {
			$('#contactModal').modal('show');
			}
			}, 5000);

            //Go to top
            $(window).scroll(function(){
                if ($(this).scrollTop() > 100) {
                    $('.scrollToTop').fadeIn();
                } else {
                    $('.scrollToTop').fadeOut();
                }
            });
            
            //Click event to scroll to top
            $('.scrollToTop').click(function(){
                $('html, body').animate({scrollTop : 0},800);
                return false;
            });
        });
    </script>
    
