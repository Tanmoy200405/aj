		<style id="wp-custom-css">
			#masthead .ast-container, .ast-header-breadcrumb .ast-container {
    max-width: 100%;
    padding-left: 0px;
    padding-right: 0px;
}
.so-marquee {
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  height: 45px;           /* compact height */
  display: flex;
  align-items: center;    /* vertically centers text and images */
  background: #fff;       /* optional: change background */
}

.so-marquee-track {
  display: inline-block;
  white-space: nowrap;
  animation: marqueeMove 20s linear infinite;
}

.so-marquee-track span {
  display: inline-block;
  margin-right: 50px;     /* spacing between items */
  vertical-align: middle;
}

.so-marquee-track img {
  height: 20px;           /* small GIFs */
  width: auto;
  vertical-align: middle;
}

.so-marquee-track a {
  text-decoration: none;
  color: #000;
  font-size: 14px;
  line-height: 45px;      /* matches container height */
  display: inline-block;
  vertical-align: middle;
}

/* Animation */
@keyframes marqueeMove {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Pause on hover */
.so-marquee-track:hover {
  animation-play-state: paused;
}
@keyframes scrollUp {
  0% { top: 100%; }
  100% { top: -100%; }
}

.scroll-box {
  position: absolute;
  width: 100%;
  animation: scrollUp 10s linear infinite;
  padding: 10px;
}
.scroll-box:hover {
  animation-play-state: paused;
}		</style>
